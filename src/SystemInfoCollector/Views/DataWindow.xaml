<Window x:Class="SystemInfoCollector.Views.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SystemInfoCollector.Converters"
        Title="Dados Coletados"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Resources>
    <converters:NullToNotAvailableConverter x:Key="NullToNotAvailableConverter" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,12,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- TextBox somente leitura para permitir selecionar e copiar os valores. -->
    <Style x:Key="ValueText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Button DockPanel.Dock="Bottom"
            Content="Fechar"
            IsCancel="True"
            IsDefault="True"
            HorizontalAlignment="Right"
            Width="96"
            Height="30"
            Margin="0,12,0,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Coleta">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Data/hora:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding CollectedAtText, Mode=OneWay}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Sistema Operacional">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Nome:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                     Text="{Binding OperatingSystem.Caption, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

            <TextBlock Grid.Row="1" Text="Versão:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"
                     Text="{Binding OperatingSystem.Version, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

            <TextBlock Grid.Row="2" Text="Arquitetura:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}"
                     Text="{Binding OperatingSystem.Architecture, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

            <TextBlock Grid.Row="3" Text="Nome do computador:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}"
                     Text="{Binding OperatingSystem.ComputerName, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Processador(es)">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding Processors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nome:" Style="{StaticResource LabelText}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                             Text="{Binding Name, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

                    <TextBlock Grid.Row="1" Text="Descrição:" Style="{StaticResource LabelText}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"
                             Text="{Binding Description, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Não disponível">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProcessors}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </GroupBox>

        <GroupBox Header=".NET Framework">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Versão:" Style="{StaticResource LabelText}" />
            <TextBox Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding NetFrameworkText, Mode=OneWay}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Interfaces de Rede">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding NetworkInterfaces}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock Grid.Row="0" Text="Nome:" Style="{StaticResource LabelText}" />
                      <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding Name, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

                      <TextBlock Grid.Row="1" Text="Descrição:" Style="{StaticResource LabelText}" />
                      <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding Description, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />

                      <TextBlock Grid.Row="2" Text="IP(s):" Style="{StaticResource LabelText}" VerticalAlignment="Top" />
                      <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding IpAddresses}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBox Style="{StaticResource ValueText}" Text="{Binding Mode=OneWay}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Grid.Row="3" Text="MAC:" Style="{StaticResource LabelText}" />
                      <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding MacAddress, Mode=OneWay, Converter={StaticResource NullToNotAvailableConverter}}" />
                    </Grid>
                    <Separator Margin="0,0,0,6" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Nenhuma interface encontrada">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasNetworkInterfaces}" Value="False">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Avisos"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBox Style="{StaticResource ValueText}" Text="{Binding Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
