<Window x:Class="SystemInfoCollector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coletor de Informações do Sistema"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="16">
    <TextBlock Text="Adriano Olivares Barbosa"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <Button Content="Coletar dados"
            Command="{Binding CollectDataCommand}" />

    <Button Content="Exibir dados"
            Command="{Binding ShowDataCommand}" />

    <ProgressBar IsIndeterminate="True"
                 Height="6"
                 Margin="0,12,0,0"
                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

    <TextBlock Text="{Binding StatusMessage}"
               TextWrapping="Wrap"
               Margin="0,12,0,0" />
  </StackPanel>
</Window>
